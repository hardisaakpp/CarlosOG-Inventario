# Copia este archivo como .env para cambiar los valores por defecto de Docker Compose.
# Todas las variables son opcionales.

POSTGRES_PASSWORD=inventario

# Puertos publicados en tu máquina.
# El frontend llama a las APIs en los puertos 5079 y 5103, así que no los cambies
# si vas a usar la aplicación desde el navegador.
DB_PORT=5433
PRODUCT_PORT=5079
TRANSACTION_PORT=5103
FRONTEND_PORT=4200
